{
  "$comment": "配置先: .kiro/orchestration/config.json(リポジトリごとに 1 つ。SDD(unity-sdd-kit)導入時は dev-orchestrator の confirmation_channel と同居する)。linear-worker はこのファイルが無いと起動しない。",
  "confirmation_channel": "claude",
  "linear": {
    "team": "<Linear チーム名>",
    "project": null,
    "labels": {
      "needs_human": "needs-human",
      "needs_local": "needs-local",
      "needs_unity": "needs-unity",
      "docs_pending": "docs-pending"
    }
  },
  "github": {
    "repo": "<owner>/<repo>",
    "default_branch": "develop",
    "release_branch": "main"
  },
  "checks": {
    "fast": [],
    "unity_ci": null
  },
  "review": {
    "provider": "action",
    "action": {
      "workflow": "codex-review.yml",
      "check_name": "codex-review",
      "max_rounds": 3,
      "model": "",
      "effort": ""
    },
    "fail_open": true,
    "bot": {
      "name": "codex",
      "login": "chatgpt-codex-connector[bot]",
      "summary_marker": "codex-pull-request-review-summary",
      "request_comment": "@codex review"
    },
    "wait_minutes": 60
  },
  "conflicts": {
    "auto_resolve": true,
    "auto_resolve_extensions": [".md", ".markdown", ".rst", ".adoc", ".asciidoc", ".txt"],
    "label": "needs-conflict-resolution"
  },
  "fast_track": {
    "enabled": true,
    "text_extensions": [".md", ".markdown", ".rst", ".adoc", ".asciidoc"],
    "text_exclude_paths": [".kiro/", "Assets/", "Packages/"],
    "require_ci": true
  },
  "worker": {
    "max_candidates": 5,
    "claim_stale_hours": 24,
    "max_parallel": 2
  },
  "docs": {
    "aggregate_paths": ["README.md", "CHANGELOG.md", "docs/backlog.md"],
    "release_branch_prefix": "release/",
    "release_label": "release-docs"
  },
  "auto_merge": {
    "enabled": true,
    "method": "merge",
    "protected_paths": [".github/", ".harness/", ".kiro/orchestration/", ".kiro/settings/", ".claude/settings.json", ".codex/"],
    "merge_parked": true
  },
  "reporting": {
    "linear_status": true,
    "notion": true
  },
  "applied_migrations": [
    "2026-10-01-auto-merge-enabled",
    "2026-10-01-protect-orchestration-config",
    "2026-10-02-protect-root-instructions",
    "2026-11-01-review-provider-action",
    "2026-11-01-protected-core-tiering",
    "2026-11-01-branch-model-keys"
  ]
}
