{
  "$comment": "配置先: .kiro/orchestration/config.json(リポジトリごとに 1 つ。SDD(unity-sdd-kit)導入時は dev-orchestrator の confirmation_channel と同居する)。linear-worker はこのファイルが無いと起動しない。",
  "confirmation_channel": "claude",
  "linear": {
    "team": "<Linear チーム名>",
    "project": null,
    "labels": {
      "needs_human": "needs-human",
      "needs_local": "needs-local",
      "needs_unity": "needs-unity",
      "docs_pending": "docs-pending"
    }
  },
  "github": {
    "repo": "<owner>/<repo>",
    "default_branch": "main"
  },
  "checks": {
    "fast": [],
    "unity_ci": null
  },
  "review": {
    "bot": {
      "name": "codex",
      "summary_marker": "codex-pull-request-review-summary",
      "request_comment": "@codex review"
    },
    "wait_minutes": 60
  },
  "fast_track": {
    "enabled": true,
    "text_extensions": [".md", ".markdown", ".rst", ".adoc", ".asciidoc"],
    "text_exclude_paths": [".kiro/", "Assets/", "Packages/"],
    "require_ci": true
  },
  "worker": {
    "max_candidates": 5,
    "claim_stale_hours": 24
  },
  "docs": {
    "aggregate_paths": ["README.md", "CHANGELOG.md", "docs/backlog.md"],
    "release_branch_prefix": "release/",
    "release_label": "release-docs"
  },
  "auto_merge": {
    "enabled": true,
    "method": "merge",
    "protected_paths": [".claude/", ".github/", ".kiro/settings/", ".kiro/orchestration/", "CLAUDE.md", "AGENTS.md", ".agents/", ".codex/"],
    "merge_parked": true
  },
  "reporting": {
    "linear_status": true,
    "notion": true
  },
  "applied_migrations": [
    "2026-10-01-auto-merge-enabled",
    "2026-10-01-protect-orchestration-config",
    "2026-10-02-protect-root-instructions"
  ]
}
